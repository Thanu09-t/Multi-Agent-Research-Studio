# Multi-Agent Research Studio Configuration
# Copy this file to .env and insert your real API credentials

# Tavily Web Search API Key (Required for Search Agent)
# Get a key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Key (Required for Writer & Critic Agents)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (Fallback or alternative model provider)
# OPENAI_API_KEY=your_openai_api_key_here
